{
  "name": "el-malek-entertainment",
  "account_id": "30900c28fc08f6b6e03f29833097d9f7",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "nahawand.org", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "el-malek-reviews",
      "database_id": "6cf556d2-eabc-4915-b003-f0d9bbede823"
    }
  ]
}
